+# Capsid: build QuickJS through quickjs-turbo's audited VM overlay (deps/quickjs/vm).
+set(QJS_BUILD_CLI OFF CACHE BOOL "" FORCE)
+set(QJS_ENABLE_INSTALL OFF CACHE BOOL "" FORCE)
+set(QJS_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
+set(QJS_FRAME_BUILD_TESTS OFF CACHE BOOL "" FORCE)
+set(QJS_BACKPORT_CONTEXT_OOM ON CACHE BOOL "" FORCE)
+set(QJS_BACKPORT_COMPUTED_ASSIGN ON CACHE BOOL "" FORCE)
+set(QJS_BACKPORT_VALUE64_INIT ON CACHE BOOL "" FORCE)
+set(QJS_BACKPORT_MIXED_NUMBERS ON CACHE BOOL "" FORCE)
+set(QJS_BACKPORT_MAP_POINTER_HASH ON CACHE BOOL "" FORCE)
+set(QJS_BACKPORT_PORTABLE_REGEXP ON CACHE BOOL "" FORCE)
+set(QJS_PROPERTY_IC ON CACHE BOOL "" FORCE)
+set(QJS_HYBRID_GC ON CACHE BOOL "" FORCE)
+if(BUILD_WITH_ASAN OR BUILD_WITH_UBSAN OR CAPSID_ENABLE_ASAN OR CAPSID_ENABLE_UBSAN OR CAPSID_ENABLE_TSAN OR CAPSID_BUILD_FUZZERS)
+    set(QJS_FRAME_BACKEND "PORTABLE" CACHE STRING "" FORCE)
+elseif(NOT DEFINED QJS_FRAME_BACKEND)
+    set(QJS_FRAME_BACKEND "AUTO" CACHE STRING "" FORCE)
+endif()
+add_subdirectory(deps/quickjs/vm EXCLUDE_FROM_ALL)
+target_link_libraries(tjs PUBLIC quickjs-turbo::qjs)
+target_link_libraries(tjsc quickjs-turbo::qjs)
 
 if(BUILD_WITH_MIMALLOC)
     option(MI_OVERRIDE "" OFF)
